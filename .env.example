# Copie para .env e preencha. O app, o bot e o docker compose leem este arquivo.

# --- Banco ---
# Sem Docker, o padrão é SQLite local (alocacao.db). Com Docker, só a senha importa:
POSTGRES_PASSWORD=troque-esta-senha
# DATABASE_URL=postgresql+psycopg://alocacao:senha@localhost:5432/alocacao

# Fuso do negócio. Todas as datas ("hoje", "amanhã") seguem este fuso, mesmo num servidor em UTC.
# APP_TIMEZONE=America/Sao_Paulo

# --- Segurança do painel e da API ---
# Senha do painel web. Vazio = sem login (só para uso no próprio computador).
PAINEL_SENHA=
# Token da API (/api/*). Vazio = API aberta. Clientes mandam: Authorization: Bearer <token>
API_TOKEN=
# Assina sessões, avisos e links de calendário (.ics). Gere uma vez, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem ela, o app cria o arquivo .secret_key na pasta.
SECRET_KEY=

# --- Agente (Gemini) ---
# Chave gratuita: https://aistudio.google.com/apikey — use um projeto SEM faturamento
# (projeto com faturamento pré-pago e sem saldo dá erro 402 em toda chamada)
GEMINI_API_KEY=
# Confira os modelos e limites do seu projeto no AI Studio. Flash-Lite costuma ter a maior cota grátis.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Telegram ---
# Crie o bot falando com o @BotFather no Telegram (/newbot) e cole o token aqui
TELEGRAM_BOT_TOKEN=
# Gestores que podem usar o bot, separados por vírgula: IDs numéricos (recomendado) ou @usuario.
# Para descobrir o seu ID: mande /id ao bot. Avisos e resumos só chegam a IDs numéricos.
TELEGRAM_USUARIOS_PERMITIDOS=
# Avisar a equipe pelo Telegram quando for escalada, removida ou a tarefa mudar de horário (1/0).
# Precisa do ID do Telegram no cadastro do funcionário, e a pessoa precisa ter mandado /start ao bot.
# AVISOS_EQUIPE=1
# Resumo semanal de certificações vencendo para os gestores, às segundas a partir das 08h (1/0).
# RESUMO_SEMANAL=1

# Onde o agente guarda conversas e aprovações pendentes
# AGENTE_DB=./agente.db

# --- Regras de agenda ---
# Descanso mínimo entre jornadas, em horas (CLT art. 66). 0 desliga.
# DESCANSO_MIN_HORAS=11
# Intervalo mínimo entre dois serviços de campo em cidades diferentes, em minutos. 0 desliga.
# DESLOCAMENTO_MIN_MINUTOS=60
